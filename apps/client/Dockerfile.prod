# Build Stage
FROM node:20-alpine as build-stage
WORKDIR /app

# Enable pnpm
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

# Copy Root Workspace configs
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy Packages
COPY packages/ ./packages/

# Copy Client App
COPY apps/client/ ./apps/client/

# Setup PNPM Cache directory
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

# Install dependencies from root with BuildKit cache mount
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

# Build Client (Scope: client)
# Vite needs env vars at build time
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ARG VITE_GOOGLE_CLIENT_ID
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ARG VITE_APP_NAME
ENV VITE_APP_NAME=$VITE_APP_NAME
ARG VITE_REVERB_APP_KEY
ENV VITE_REVERB_APP_KEY=$VITE_REVERB_APP_KEY
ARG VITE_REVERB_HOST
ENV VITE_REVERB_HOST=$VITE_REVERB_HOST
ARG VITE_REVERB_PORT
ENV VITE_REVERB_PORT=$VITE_REVERB_PORT
ARG VITE_REVERB_SCHEME
ENV VITE_REVERB_SCHEME=$VITE_REVERB_SCHEME

# Limit memory usage to prevent OOM on server
ENV NODE_OPTIONS="--max-old-space-size=1024"

# Run build from root using filter (Skip vue-tsc for production build reliability)
RUN pnpm --filter client exec vite build

# Production Stage
FROM nginx:stable-alpine as production-stage
COPY --from=build-stage /app/apps/client/dist /usr/share/nginx/html
# Custom Nginx config to handle SPA routing
COPY apps/client/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
