FROM debian:12-slim

# Install system dependencies (curl for healthcheck, unzip/git for composer)
RUN apt-get update && apt-get install -y curl ca-certificates unzip git && rm -rf /var/lib/apt/lists/*

# Copy pre-compiled FrankenPHP static binary
ADD https://github.com/dunglas/frankenphp/releases/latest/download/frankenphp-linux-x86_64 /usr/local/bin/frankenphp
RUN chmod +x /usr/local/bin/frankenphp

# Create a wrapper script so 'php' executes 'frankenphp php-cli'
RUN printf '#!/bin/sh\nexec /usr/local/bin/frankenphp php-cli "$@"\n' > /usr/local/bin/php && \
    chmod +x /usr/local/bin/php

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Set working directory
WORKDIR /var/www/html

# Copy Composer files first for layer caching
COPY --chown=1000:1000 composer.json composer.lock ./

# Install dependencies with BuildKit cache mount
RUN --mount=type=cache,id=composer,target=/tmp/cache \
    COMPOSER_CACHE_DIR=/tmp/cache \
    composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader --ignore-platform-reqs --no-scripts

# Copy application code
COPY --chown=1000:1000 . .

# Run post-install scripts
RUN composer dump-autoload --optimize --no-scripts

# Create required directories and set safe permissions
RUN mkdir -p storage/logs storage/framework/cache storage/framework/sessions storage/framework/views bootstrap/cache && \
    chown -R 1000:1000 storage bootstrap/cache

# Add custom overrides for php.ini
RUN mkdir -p /usr/local/etc/php/conf.d
COPY upload.ini /usr/local/etc/php/conf.d/99-upload.ini

# Copy startup script
COPY start-container.sh /usr/local/bin/start-container
RUN chmod +x /usr/local/bin/start-container

# Expose FrankenPHP port
EXPOSE 8080

# Start Octane via script
ENTRYPOINT ["/usr/local/bin/start-container"]
