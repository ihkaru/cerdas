#!/usr/bin/env python3
"""
cerdas - Agent-First CLI for Cerdas Open-Source Survey & Data Collection Platform.

Conforms to 2026 Agent-First CLI Standards:
1. Machine-Readable JSON First (predictable ok, error, code, data, suggestion).
2. Runtime Schema Introspection (`cerdas schema --all`).
3. Strict Non-Interactivity (flags, stdin payloads, --force, --yes, --dry-run).
4. Context Window Discipline (--fields masking, pagination --limit, --page).
5. Idempotent Operations & Declarative Verbs (--if-not-exists, upsert strategies).
6. Actionable Error Handling (typed error codes, next-action suggestions).
7. End-to-End GSBPM Statistical Workflow Alignment.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

CLI_VERSION = "1.0.0"
CONFIG_FILE = Path.home() / ".config" / "cerdas" / "config.json"


# ==============================================================================
# Configuration Management
# ==============================================================================

def load_config() -> Dict[str, Any]:
    cfg = {
        "base_url": os.getenv("CERDAS_BASE_URL", "http://127.0.0.1:8000"),
        "api_key": os.getenv("CERDAS_API_KEY") or os.getenv("CERDAS_SUPERADMIN_KEY", ""),
    }
    if CONFIG_FILE.exists():
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                saved = json.load(f)
                if saved.get("base_url") and not os.getenv("CERDAS_BASE_URL"):
                    cfg["base_url"] = saved["base_url"].rstrip("/")
                if saved.get("api_key") and not os.getenv("CERDAS_API_KEY") and not os.getenv("CERDAS_SUPERADMIN_KEY"):
                    cfg["api_key"] = saved["api_key"]
        except Exception:
            pass
    cfg["base_url"] = cfg["base_url"].rstrip("/")
    return cfg


def save_config(updates: Dict[str, Any]) -> None:
    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    current = {}
    if CONFIG_FILE.exists():
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                current = json.load(f)
        except Exception:
            pass
    current.update(updates)
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        json.dump(current, f, indent=2)


def mask_key(k: str) -> str:
    if not k:
        return "<none>"
    if len(k) <= 8:
        return "•" * len(k)
    return k[:6] + "•" * 12 + k[-4:]


# ==============================================================================
# Output & Context Filtering
# ==============================================================================

def output_result(ok: bool, data: Any = None, message: str = "", code: int = 200,
                  suggestion: str = "", fields: Optional[str] = None,
                  table_mode: bool = False, next_actions: Optional[List[str]] = None) -> None:
    if not ok:
        err_res = {
            "ok": False,
            "error": "request_failed" if code >= 400 else "error",
            "code": code,
            "message": message or "An error occurred.",
            "suggestion": suggestion or "Check command arguments with --help or run 'cerdas schema'.",
            "retryable": code in (408, 429, 500, 502, 503, 504),
        }
        print(json.dumps(err_res, indent=2))
        sys.exit(1)

    # Field Masking for Context Window Discipline
    filtered_data = data
    if fields and isinstance(data, (dict, list)):
        target_fields = [f.strip() for f in fields.split(",") if f.strip()]
        if isinstance(data, list):
            filtered_data = [
                {k: item[k] for k in target_fields if k in item}
                if isinstance(item, dict) else item
                for item in data
            ]
        elif isinstance(data, dict):
            # Check if paginated container
            if "data" in data and isinstance(data["data"], list):
                paginated_items = [
                    {k: item[k] for k in target_fields if k in item}
                    if isinstance(item, dict) else item
                    for item in data["data"]
                ]
                filtered_data = dict(data)
                filtered_data["data"] = paginated_items
            else:
                filtered_data = {k: data[k] for k in target_fields if k in data}

    res: Dict[str, Any] = {
        "ok": True,
        "code": code,
        "message": message,
        "data": filtered_data,
    }
    if next_actions:
        res["next_actions"] = next_actions

    if table_mode and isinstance(filtered_data, list) and len(filtered_data) > 0 and isinstance(filtered_data[0], dict):
        # Human-readable table fallback
        keys = list(filtered_data[0].keys())[:6]
        header = " | ".join(f"{k:<18}" for k in keys)
        sep = "-+-".join("-" * 18 for _ in keys)
        print(header)
        print(sep)
        for row in filtered_data:
            print(" | ".join(f"{str(row.get(k, ''))[:18]:<18}" for k in keys))
    else:
        print(json.dumps(res, indent=2))
    sys.exit(0)


# ==============================================================================
# HTTP Transport Client
# ==============================================================================

class CerdasClient:
    def __init__(self, base_url: str, api_key: str):
        self.base_url = base_url.rstrip("/")
        self.api_key = api_key

    def request(self, method: str, endpoint: str, body: Optional[Dict[str, Any]] = None,
                params: Optional[Dict[str, Any]] = None) -> Tuple[int, Dict[str, Any]]:
        url = f"{self.base_url}{endpoint}"
        if params:
            clean_params = {k: v for k, v in params.items() if v is not None}
            if clean_params:
                url += "?" + urllib.parse.urlencode(clean_params)

        headers = {
            "Accept": "application/json",
            "Content-Type": "application/json",
            "User-Agent": f"cerdas-cli/{CLI_VERSION} (agent-first)",
        }
        if self.api_key:
            headers["X-Api-Key"] = self.api_key
            headers["Authorization"] = f"Bearer {self.api_key}"

        data_bytes = json.dumps(body).encode("utf-8") if body is not None else None
        req = urllib.request.Request(url, data=data_bytes, headers=headers, method=method.upper())

        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                status = resp.status
                raw = resp.read().decode("utf-8")
                try:
                    payload = json.loads(raw)
                except Exception:
                    payload = {"raw": raw}
                return status, payload
        except urllib.error.HTTPError as e:
            status = e.code
            raw = e.read().decode("utf-8")
            try:
                payload = json.loads(raw)
            except Exception:
                payload = {"message": raw}
            return status, payload
        except urllib.error.URLError as e:
            return 503, {
                "message": f"Cannot connect to Cerdas server at '{self.base_url}': {e.reason}",
                "suggestion": "Check if Cerdas backend is running or update endpoint via 'cerdas config set-url <url>'.",
            }


